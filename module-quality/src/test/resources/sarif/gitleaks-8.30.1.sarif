{
 "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
 "version": "2.1.0",
 "runs": [
  {
   "tool": {
    "driver": {
     "name": "gitleaks",
     "semanticVersion": "v8.0.0",
     "informationUri": "https://github.com/gitleaks/gitleaks",
     "rules": [
      {
       "id": "aws-access-token",
       "shortDescription": {
        "text": "Identified a pattern that may indicate AWS credentials, risking unauthorized cloud resource access and data breaches on AWS platforms."
       }
      },
      {
       "id": "github-pat",
       "shortDescription": {
        "text": "Uncovered a GitHub Personal Access Token, potentially leading to unauthorized repository access and sensitive content exposure."
       }
      },
      {
       "id": "jwt",
       "shortDescription": {
        "text": "Uncovered a JSON Web Token, which may lead to unauthorized access to web applications and sensitive user data."
       }
      },
      {
       "id": "slack-webhook-url",
       "shortDescription": {
        "text": "Discovered a Slack Webhook, which could lead to unauthorized message posting and data leakage in Slack channels."
       }
      },
      {
       "id": "stripe-access-token",
       "shortDescription": {
        "text": "Found a Stripe Access Token, posing a risk to payment processing services and sensitive financial data."
       }
      }
     ]
    }
   },
   "results": [
    {
     "message": {
      "text": "slack-webhook-url has detected secret for file artifacts/notify.json."
     },
     "ruleId": "slack-webhook-url",
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "artifacts/notify.json"
        },
        "region": {
         "startLine": 1,
         "startColumn": 14,
         "endLine": 1,
         "endColumn": 90,
         "snippet": {
          "text": "REDACTED"
         }
        }
       }
      }
     ],
     "partialFingerprints": {
      "commitSha": "",
      "email": "",
      "author": "",
      "date": "",
      "commitMessage": ""
     },
     "properties": {
      "tags": []
     }
    },
    {
     "message": {
      "text": "jwt has detected secret for file artifacts/session.txt."
     },
     "ruleId": "jwt",
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "artifacts/session.txt"
        },
        "region": {
         "startLine": 1,
         "startColumn": 16,
         "endLine": 1,
         "endColumn": 99,
         "snippet": {
          "text": "REDACTED"
         }
        }
       }
      }
     ],
     "partialFingerprints": {
      "commitSha": "",
      "email": "",
      "author": "",
      "date": "",
      "commitMessage": ""
     },
     "properties": {
      "tags": []
     }
    },
    {
     "message": {
      "text": "stripe-access-token has detected secret for file artifacts/payments.log."
     },
     "ruleId": "stripe-access-token",
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "artifacts/payments.log"
        },
        "region": {
         "startLine": 1,
         "startColumn": 19,
         "endLine": 1,
         "endColumn": 50,
         "snippet": {
          "text": "REDACTED"
         }
        }
       }
      }
     ],
     "partialFingerprints": {
      "commitSha": "",
      "email": "",
      "author": "",
      "date": "",
      "commitMessage": ""
     },
     "properties": {
      "tags": []
     }
    },
    {
     "message": {
      "text": "github-pat has detected secret for file artifacts/ci-env.txt."
     },
     "ruleId": "github-pat",
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "artifacts/ci-env.txt"
        },
        "region": {
         "startLine": 1,
         "startColumn": 14,
         "endLine": 1,
         "endColumn": 53,
         "snippet": {
          "text": "REDACTED"
         }
        }
       }
      }
     ],
     "partialFingerprints": {
      "commitSha": "",
      "email": "",
      "author": "",
      "date": "",
      "commitMessage": ""
     },
     "properties": {
      "tags": []
     }
    },
    {
     "message": {
      "text": "aws-access-token has detected secret for file artifacts/config-dump.txt."
     },
     "ruleId": "aws-access-token",
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "artifacts/config-dump.txt"
        },
        "region": {
         "startLine": 1,
         "startColumn": 21,
         "endLine": 1,
         "endColumn": 40,
         "snippet": {
          "text": "REDACTED"
         }
        }
       }
      }
     ],
     "partialFingerprints": {
      "commitSha": "",
      "email": "",
      "author": "",
      "date": "",
      "commitMessage": ""
     },
     "properties": {
      "tags": []
     }
    }
   ]
  }
 ]
}